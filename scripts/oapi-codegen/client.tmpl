{{ template "client" dict "config" .Config "operations" .Operations }}

{{define "resultType"}}{{if gt (len .Response.Successes) 1}}{{.ID}}Result{{else}}{{.Response.Success.ResponseName}}{{end}}{{end}}

{{range .Operations}}{{$op := .}}
{{if gt (len $op.Response.Successes) 1}}
// {{$op.ID}}Result contains the decoded body for the returned success status.
type {{$op.ID}}Result struct {
    {{range $op.Response.Successes}}Status{{.StatusCode}} *{{.ResponseName}}
    {{end}}
}
{{end}}{{end}}

{{- define "responseParserFn" }}{{$op := .op}}
responseParser := func(_ context.Context, resp *runtime.Response) (*{{template "resultType" $op}}, error) {
    switch resp.StatusCode {
    {{range $op.Response.Successes}}{{$rcd := .}}
    case {{.StatusCode}}:
        {{if eq .ResponseName "struct{}"}}
        target := new(struct{})
        {{else if .IsRaw}}
        target := new({{.ResponseName}}(resp.Content))
        {{else if eq .Schema.GoType "string"}}
        target := new({{.ResponseName}}(resp.Content))
        {{else}}
        target := new({{.ResponseName}})
        if err := json.Unmarshal(resp.Content, target); err != nil {
            return nil, &runtime.ResponseDecodeError{
                StatusCode: resp.StatusCode, ContentType: resp.Headers.Get("Content-Type"),
                ContentLength: len(resp.Content), TargetType: "{{.ResponseName}}", Body: resp.Content, Err: err,
            }
        }
        {{end}}
        {{if gt (len $op.Response.Successes) 1}}
        return &{{$op.ID}}Result{Status{{.StatusCode}}: target}, nil
        {{else}}
        return target, nil
        {{end}}
    {{end}}
    default:
        {{with $op.Response.Error}}{{if .ResponseName}}
        return nil, decodeAPIError[{{.ResponseName}}](resp, "{{.ResponseName}}")
        {{else}}
        return nil, runtime.NewClientAPIError(fmt.Errorf("unexpected status code: %d", resp.StatusCode), runtime.WithStatusCode(resp.StatusCode))
        {{end}}{{else}}
        return nil, runtime.NewClientAPIError(fmt.Errorf("unexpected status code: %d", resp.StatusCode), runtime.WithStatusCode(resp.StatusCode))
        {{end}}
    }
}
