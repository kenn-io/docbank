{
  "name": "docbank-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-embedpdf.mjs",
    "dev": "vp dev",
    "build": "vp build",
    "fmt": "vp fmt",
    "check:fmt-lint": "vp fmt --check && vp lint --format unix",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:kit-ui": "kit-ui-check src",
    "docs-site:check": "tsc -p docs-site/tsconfig.json --noEmit",
    "docs-site:test": "node node_modules/@playwright/test/cli.js test --config docs-site/playwright.config.ts",
    "screenshots": "node screenshots/run.mjs",
    "screenshots:check": "tsc -p screenshots/tsconfig.json --noEmit && node --test screenshots/publish.node-test.mjs",
    "test": "vp test run",
    "generate:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/svelte-pdf-viewer": "2.15.1",
    "@kenn-io/kit-ui": "git+https://github.com/kenn-io/kit-ui.git#5b99e44d9e9cfbaca05868f146b674cb6eea39a0",
    "@lucide/svelte": "1.64.0",
    "@noble/hashes": "^2.2.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "svelte": "5.57.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@hegeldev/hegel": "^0.5.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.7",
    "ignore": "7.0.14",
    "jsdom": "30.1.3",
    "orval": "8.45.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "npm@12.2.1"
}
