# npm 12 refuses git dependencies by default. Allow the ones package.json
# names directly, such as @kenn-io/kit-ui, and still refuse git dependencies
# of dependencies.
allow-git=root

# npm installs only versions published at least 7 days ago, matching the
# shared Renovate release-age preset in kenn-io/actions. Needs npm 11.10 or
# later.
min-release-age=7
