<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
  <office:styles>
    <style:presentation-page-layout style:name="Title">
      <presentation:placeholder presentation:object="title" svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="4cm"/>
      <presentation:placeholder presentation:object="subtitle" svg:x="2cm" svg:y="7cm" svg:width="24cm" svg:height="8cm"/>
    </style:presentation-page-layout>
    <style:presentation-page-layout style:name="Content">
      <presentation:placeholder presentation:object="title" svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="4cm"/>
      <presentation:placeholder presentation:object="outline" svg:x="2cm" svg:y="7cm" svg:width="24cm" svg:height="12cm"/>
    </style:presentation-page-layout>
    <text:list-style style:name="Bullets">
      <text:list-level-style-bullet text:level="1" text:bullet-char="&#8226;"/>
    </text:list-style>
  </office:styles>
  <office:automatic-styles>
    <style:page-layout style:name="Page">
      <style:page-layout-properties fo:page-width="28cm" fo:page-height="21cm" style:print-orientation="landscape"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Default" style:page-layout-name="Page"/>
  </office:master-styles>
  <office:body>
    <office:presentation>
      <draw:page draw:name="Introduction" draw:master-page-name="Default" presentation:presentation-page-layout-name="Title">
        <draw:frame presentation:class="title" svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="4cm">
          <draw:text-box><text:p>Synthetic presentation</text:p></draw:text-box>
        </draw:frame>
        <draw:frame presentation:class="subtitle" svg:x="2cm" svg:y="7cm" svg:width="24cm" svg:height="8cm">
          <draw:text-box><text:p>Two slide layouts</text:p></draw:text-box>
        </draw:frame>
      </draw:page>
      <draw:page draw:name="Content" draw:master-page-name="Default" presentation:presentation-page-layout-name="Content">
        <draw:frame presentation:class="title" svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="4cm">
          <draw:text-box><text:p>Inventory overview</text:p></draw:text-box>
        </draw:frame>
        <draw:frame presentation:class="outline" svg:x="2cm" svg:y="7cm" svg:width="24cm" svg:height="12cm">
          <draw:text-box><text:list text:style-name="Bullets">
            <text:list-item><text:p>Apples</text:p></text:list-item>
            <text:list-item><text:p>Pears</text:p></text:list-item>
          </text:list></draw:text-box>
        </draw:frame>
        <presentation:notes>
          <draw:frame presentation:class="notes" svg:x="2cm" svg:y="12cm" svg:width="17cm" svg:height="10cm">
            <draw:text-box><text:p>Synthetic speaker notes</text:p></draw:text-box>
          </draw:frame>
        </presentation:notes>
      </draw:page>
    </office:presentation>
  </office:body>
</office:document>
