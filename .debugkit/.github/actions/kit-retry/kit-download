#!/usr/bin/env bash
set -eu

if [ "$#" -ne 2 ] || [ -d "$2" ]; then
    echo 'usage: kit-download URL DEST' >&2
    exit 2
fi
URL=$1
DEST=$2
tmp="$DEST.part.$$"
trap 'rm -f "$tmp"' EXIT
"$(dirname -- "${BASH_SOURCE[0]}")/kit-retry" 3 5 curl --silent --show-error --fail --location --connect-timeout 30 --speed-limit 1 --speed-time 60 -o "$tmp" "$URL"
mv -f "$tmp" "$DEST"
