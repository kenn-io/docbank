{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": [
        "Vite+ selects these bundled versions. Update direct pins to match Vite+ toolchain upgrades, never independently."
      ],
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "vite",
        "@voidzero-dev/vite-plus-core",
        "rolldown",
        "tsdown",
        "vitest",
        "@vitest/**",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt"
      ],
      "enabled": false
    },
    {
      "description": [
        "Update Vite+ everywhere it runs together. Review bundled tool pins with each toolchain upgrade."
      ],
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite-plus"],
      "groupName": "Vite+ toolchain",
      "groupSlug": "vite-plus-toolchain"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/^(7\\.0\\.)/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "Docker images",
      "groupSlug": "docker-images"
    },
    {
      "description": [
        "Compose builds this image locally. The tag is not a registry dependency."
      ],
      "matchManagers": ["docker-compose"],
      "matchDepNames": ["docbank-glmocr"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "Python dependencies",
      "groupSlug": "python-dependencies"
    },
    {
      "matchDepNames": ["golangci-lint", "golangci/golangci-lint"],
      "groupName": "golangci-lint",
      "groupSlug": "golangci-lint"
    },
    {
      "matchDepNames": ["vercel"],
      "groupName": "JavaScript dependencies",
      "groupSlug": "javascript-dependencies"
    },
    {
      "description": ["kenn-io releases open right away: no release-age wait and no weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.custom-gcl\\.yml$/"],
      "matchStrings": ["^version:\\s*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/deploy-docs\\.yml$/"],
      "matchStrings": [
        "npm install --global vercel@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "vercel",
      "versioningTemplate": "semver"
    }
  ]
}
